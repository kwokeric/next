generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  color     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  tasks     Task[]

  @@index([userId])
}

enum TaskStatus {
  TODO
  DONE
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Coarse bucket for grouping a day's tasks in the schedule view. Independent
// of `scheduledTime` — a task can have a bucket with no precise time at all.
enum TimeOfDay {
  ANYTIME
  MORNING
  AFTERNOON
  EVENING
}

// A recurring task doesn't stay DONE — completing it rolls `scheduledFor`
// forward to its next occurrence and resets status to TODO instead (see
// the PATCH /api/tasks/[taskId] handler). WEEKDAYS skips Sat/Sun; the
// others are a fixed-length step from the previous `scheduledFor`.
enum RepeatFrequency {
  DAILY
  WEEKLY
  MONTHLY
  WEEKDAYS
}

model Task {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTaskId String?
  parent       Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]     @relation("TaskSubtasks")
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  // Hard deadline: the day it's due, and (optionally) the exact time that
  // day — the seam a future notifications feature hooks into.
  dueDate      DateTime?  @db.Date
  dueTime      DateTime?  @db.Time
  // Soft plan: which day the user intends to work on it. Unset tasks are
  // unscheduled and only ever surface via the natural (depth-first) next
  // task search, never the scheduled one. A day that passes without the
  // task being done isn't rewritten — see findNextTask's `today` handling,
  // which treats any `scheduledFor <= today` as due today ("rolls over").
  scheduledFor  DateTime?  @db.Date
  timeOfDay     TimeOfDay  @default(ANYTIME)
  scheduledTime DateTime?  @db.Time
  // Unset (the default) means "doesn't repeat."
  repeatFrequency RepeatFrequency?
  // Fractional-index sort key (see fractional-indexing package) — a plain
  // string so siblings can be reordered/inserted without renumbering rows.
  order        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectId])
  @@index([parentTaskId])
}
