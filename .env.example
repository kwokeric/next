## Postgres connection string. Use a local Postgres, Docker, or a free
## managed instance (Neon, Supabase, Railway all work fine).
DATABASE_URL="postgresql://user:password@localhost:5432/next_app"

## Anthropic API key — get one at https://platform.claude.com
ANTHROPIC_API_KEY="sk-ant-..."

## Shared secret checked by POST /api/reset before it wipes and reseeds the
## demo project. Generate one with `openssl rand -hex 32`. Must match the
## RESET_SECRET GitHub Actions secret used by .github/workflows/reset-demo.yml.
RESET_SECRET="..."
